# Copy this file to .env before using Docker Compose.
# Never commit your real .env file.

AVATARFORGE_PORT=8000
AVATARFORGE_SECRET_KEY=replace-with-a-long-random-secret
AVATARFORGE_SESSION_COOKIE_SECURE=0
AVATARFORGE_TRUST_PROXY_HEADERS=0

POSTGRES_DB=avatarforge
POSTGRES_USER=avatarforge
POSTGRES_PASSWORD=replace-with-a-strong-password

# mock works with no paid AI provider.
AVATARFORGE_AI_PROVIDER=mock
FAL_KEY=

# Step 12 defaults. Leave local unless you configure an S3-compatible bucket.
AVATARFORGE_STORAGE_BACKEND=local
AVATARFORGE_JOB_MAX_ATTEMPTS=2
AVATARFORGE_JOB_RETENTION_HOURS=24
AVATARFORGE_JSON_LOGS=1
AVATARFORGE_LOG_LEVEL=INFO
AVATARFORGE_S3_BUCKET=
AVATARFORGE_S3_PREFIX=avatarforge
AVATARFORGE_S3_REGION=
AVATARFORGE_S3_ENDPOINT_URL=
AVATARFORGE_S3_ACCESS_KEY_ID=
AVATARFORGE_S3_SECRET_ACCESS_KEY=
