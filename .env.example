# Generate a long random value before production deployment.
AVATARFORGE_SECRET_KEY=replace-me-with-a-long-random-secret

# Local default is SQLite when DATABASE_URL is omitted.
# PostgreSQL production example:
# DATABASE_URL=postgresql://avatarforge:password@localhost:5432/avatarforge

# Optional custom location for private generated outputs.
# AVATARFORGE_GENERATED_DIR=/absolute/private/path/generated

# development | production
AVATARFORGE_ENV=development

# Generative AI provider
# Use mock while developing without a paid provider.
AVATARFORGE_AI_PROVIDER=mock

# fal.ai (optional real image-to-image provider)
# Never commit the real value. Create a key in your fal.ai account when ready.
FAL_KEY=

# Generic remote provider (optional alternative)
AVATARFORGE_AI_ENDPOINT=
AVATARFORGE_AI_API_KEY=
AVATARFORGE_AI_TIMEOUT=120

# Step 10 asynchronous generation jobs
# thread = built-in local background worker (default)
# inline = useful for deterministic tests
# rq = Redis/RQ worker for multi-process production deployments
AVATARFORGE_JOB_BACKEND=thread
REDIS_URL=redis://localhost:6379/0
AVATARFORGE_RQ_QUEUE=avatarforge
AVATARFORGE_JOB_TIMEOUT=300

# Step 11 production/runtime settings
# Set to 1 only when requests arrive through a trusted reverse proxy/load balancer.
AVATARFORGE_TRUST_PROXY_HEADERS=0
# Production deployments behind HTTPS should use 1. Set 0 only for local HTTP Docker testing.
AVATARFORGE_SESSION_COOKIE_SECURE=1
# Gunicorn/container settings
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180
AVATARFORGE_RUN_MIGRATIONS=1

# Step 12 storage lifecycle and observability
# local = filesystem storage (default); s3 = S3 or S3-compatible object storage.
AVATARFORGE_STORAGE_BACKEND=local
AVATARFORGE_JOB_MAX_ATTEMPTS=2
AVATARFORGE_JOB_RETENTION_HOURS=24
AVATARFORGE_JSON_LOGS=0
AVATARFORGE_LOG_LEVEL=INFO

# Optional S3-compatible storage configuration.
AVATARFORGE_S3_BUCKET=
AVATARFORGE_S3_PREFIX=avatarforge
AVATARFORGE_S3_REGION=
AVATARFORGE_S3_ENDPOINT_URL=
AVATARFORGE_S3_ACCESS_KEY_ID=
AVATARFORGE_S3_SECRET_ACCESS_KEY=
AVATARFORGE_S3_SSE=AES256

# Developer API
AVATARFORGE_API_MONTHLY_GENERATION_QUOTA=100
AVATARFORGE_API_RATE_LIMIT_PER_MINUTE=30
# Use redis in distributed/serverless production; memory is local-development only.
AVATARFORGE_RATE_LIMIT_BACKEND=memory

# Billing (mock locally; stripe in production)
AVATARFORGE_BILLING_PROVIDER=mock
AVATARFORGE_APP_BASE_URL=http://127.0.0.1:5000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Step 15 account security and transactional email
# Production defaults to requiring verified email addresses.
AVATARFORGE_EMAIL_VERIFICATION_REQUIRED=0
AVATARFORGE_EMAIL_VERIFICATION_TOKEN_MAX_AGE=86400
AVATARFORGE_PASSWORD_RESET_TOKEN_MAX_AGE=3600
# console = safe local outbox; smtp = external transactional email provider.
AVATARFORGE_EMAIL_BACKEND=console
AVATARFORGE_EMAIL_FROM=no-reply@example.com
# For Vercel/serverless production, resend is recommended over SMTP.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
# Keep enabled in production so an ephemeral/local SQLite database is never used accidentally.
AVATARFORGE_REQUIRE_POSTGRES_IN_PRODUCTION=1
