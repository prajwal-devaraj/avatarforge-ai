# Generate a long random value before production deployment.
AVATARFORGE_SECRET_KEY=replace-me-with-a-long-random-secret

# Local default is SQLite when DATABASE_URL is omitted.
# PostgreSQL production example:
# DATABASE_URL=postgresql://avatarforge:password@localhost:5432/avatarforge

# Optional custom location for private generated outputs.
# AVATARFORGE_GENERATED_DIR=/absolute/private/path/generated

# development | production
AVATARFORGE_ENV=development
